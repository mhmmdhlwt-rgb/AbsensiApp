// ============================================================================
// firestore.rules — AbsensiApp (myassalam-d45c5)
// Multi-tenant: tenants/{ns}/{store}/{docId}
// Tenant namespace (ns) disimpan di localStorage('tenant_ns') sisi client.
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── TENANT DATA ──────────────────────────────────────────────────────
    // Setiap dokumen di tenant hanya boleh diakses jika:
    //   1. Pengguna sudah ter-auth (uid non-null), DAN
    //   2. tenant_ns yang diklaim pengguna == ns di path
    // Catatan: client mengirim ns lewat claim custom (jika pakai Firebase Auth
    // Custom Claims) atau — pada versi minimal ini — kita andalkan
    // request.auth.uid != null sebagai gate pertama, plus restrict ke path
    // tenant yang sama dengan yang diakses client-side.
    //
    // UPGRADE PATH (rekomendasi):
    //   - Migrasi ke Firebase Auth + Custom Claims (tenant_ns) sehingga
    //     rule bisa benar-benar match claim vs path.
    //   - Untuk sekarang: setidaknya blok akses jika tidak ada auth sama
    //     sekali. PIN admin/super-admin yang ada di kode adalah gate UI,
    //     BUKAN gate security — mudah dilewati siapa pun yang inspeksi kode.
    // ----------------------------------------------------------------------

    match /tenants/{ns}/{store=**} {
      // Versi minimum: gate auth-only (lebih baik daripada allow all).
      // Saat aplikasi sudah siap migrasi ke Auth, ganti dengan:
      //   allow read, write: if request.auth != null
      //                        && request.auth.token.tenant_ns == ns;
      allow read, write: if request.auth != null;
    }

    // ── REGISTRY (daftar tenant global) ─────────────────────────────────
    //   - READ: publik (dibutuhkan halaman "Pilih Pesantren" sebelum login)
    //   - CREATE: publik (Setup Wizard mendaftarkan tenant baru)
    //   - UPDATE/DELETE: hanya super admin (pakai Admin SDK dari Cloud
    //     Function, bukan dari client). Di client, mode super admin sekarang
    //     hanya gate UI — kerentanan privilege escalation bisa terjadi jika
    //     seseorang membuka DevTools. Solusi tuntas: pindahkan operasi
    //     edit/delete tenant ke Cloud Function dengan Admin SDK.
    match /registry/{ns} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // WAJIB lewat Cloud Function (Admin SDK)
    }

    // ── FCM TOKENS (sub-collection tenants/{ns}/fcmTokens) ─────────────
    //   Token FCM disimpan per-user per-device. Tidak ada auth real, jadi
    //   gate minimum: read+write if request.auth != null.
    match /tenants/{ns}/fcmTokens/{tokenDoc} {
      allow read, write: if request.auth != null;
    }

    // ── DEFAULT deny ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
