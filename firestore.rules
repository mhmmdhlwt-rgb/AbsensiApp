rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /tenants/{ns}/{store=**} {
      allow read, write: if request.auth != null;
    }

    match /registry/{ns} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
