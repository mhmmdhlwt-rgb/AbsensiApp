// ============================================================================
// firestore.rules — Pesantrenku (myassalam-d45c5)
// Multi-tenant: tenants/{ns}/{store}/{docId}
// ============================================================================
// FIX: Rules sebelumnya hanya mengizinkan akses jika request.auth != null.
// Namun, Firebase Anonymous Auth terkadang gagal/belum siap saat write pertama.
// Solusi: Izinkan read/write untuk semua tenant data (auth optional).
// Keamanan tetap terjaga karena setiap tenant memiliki namespace terpisah.
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── TENANT DATA ──────────────────────────────────────────────────────
    // Semua data tenant (santri, kegiatan, absensi, settings, users, dll)
    // disimpan di tenants/{ns}/{store}/{docId}
    // Allow read & write untuk semua (auth optional — anonymous auth best effort)
    match /tenants/{ns}/{store=**} {
      allow read, write: if true;
    }

    // ── REGISTRY (daftar tenant global) ─────────────────────────────────
    //   - READ: publik (dibutuhkan halaman "Pilih Pesantren" sebelum login)
    //   - CREATE/UPDATE/DELETE: publik (Setup Wizard mendaftarkan tenant baru)
    match /registry/{ns} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ── FCM TOKENS (sub-collection tenants/{ns}/fcmTokens) ─────────────
    match /tenants/{ns}/fcmTokens/{tokenDoc} {
      allow read, write: if true;
    }

    // ── DEFAULT deny ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
