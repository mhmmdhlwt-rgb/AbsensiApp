rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read & write for all tenant photos (auth optional)
    match /tenants/{tenant}/photos/{allPaths=**} {
      allow read, write: if true;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
